# ============================================================
# CONNECT - Environment Configuration (.env.example)
# ============================================================
# Copy this file to .env for local development or set these
# variables in your Render Web Service Environment Settings.
# ============================================================

# Django Core
SECRET_KEY=your-django-production-secret-key-change-this
DEBUG=False
ALLOWED_HOSTS=.onrender.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://*.onrender.com

# Database
# Leave blank for local development to use SQLite (db.sqlite3)
# In production on Render, connect your PostgreSQL instance:
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Channel Layer / Redis (Django Channels & WebSocket)
# Leave blank for local development to use InMemoryChannelLayer (no Redis needed)
# In production on Render, provide your managed Redis URL:
REDIS_URL=redis://default:password@hostname:6379

# AI & Speech Services (Optional / As needed)
GEMINI_API_KEY=
GLADIA_API_KEY=
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=
